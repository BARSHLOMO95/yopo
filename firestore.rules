rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // כללי אבטחה לקטלוג המוצרים

    // נתיב לנתונים ציבוריים
    match /artifacts/{appId}/public/data/{document=**} {
      // כולם יכולים לקרוא
      allow read: true;

      // רק משתמשים מחוברים יכולים לכתוב
      // (Anonymous authentication מספיק)
      allow write: if request.auth != null;
    }

    // חסום הכל אחר כברירת מחדל
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
